 function renderToolChromeLines(component: any, rendered: string[], width: number): string[] {
+	const cache = component?.[TOOL_CHROME_RENDER_CACHE_SYMBOL] as ToolChromeRenderCache | undefined;
+	if (cache) {
+		const generation = currentSettingsGeneration();
+		for (const entry of cache.entries) {
+			if (entry.width === width && entry.generation === generation && sameRenderedLines(entry.source, rendered)) {
+				return entry.result;
