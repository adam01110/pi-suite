+import { appendFileSync } from "node:fs";
+import { createInterface } from "node:readline";
+
+const record = (event) => appendFileSync(process.argv[2], `${event}\n`);
+const reply = (id, result) => process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", id, result })}\n`);
+record("start");
+let held;
+const input = createInterface({ input: process.stdin });
+input.on("line", (line) => {
+	const message = JSON.parse(line);
+	if (message.id === undefined) return;
+	record(message.method);
+	if (message.method === process.argv[3]) {
+		record("stalled");
+		process.stdout.write(`${JSON.stringify({ jsonrpc: "2.0", method: "notifications/lazy/stalled" })}\n`);
+		return;
+	}
+	if (message.method === "initialize") {
+		reply(message.id, {
+			protocolVersion: message.params.protocolVersion,
+			capabilities: { tools: {}, resources: {} },
+			serverInfo: { name: "lazy-test", version: "1" },
+		});
+	} else if (message.method === "tools/list") {
+		reply(message.id, {
+			tools: [
+				{ name: "echo", inputSchema: { type: "object" } },
+				{ name: "hold", inputSchema: { type: "object" } },
+				{ name: "release", inputSchema: { type: "object" } },
+			],
+		});
+	} else if (message.method === "resources/list") {
+		reply(message.id, { resources: [{ name: "doc", uri: "test://doc" }] });
+	} else if (message.method === "resources/templates/list") {
+		reply(message.id, { resourceTemplates: [] });
+	} else if (message.method === "resources/read") {
+		reply(message.id, { contents: [{ uri: message.params.uri, text: "resource" }] });
+	} else if (message.method === "tools/call") {
+		if (message.params.name === "hold") {
+			held = message.id;
+			record("held");
+			return;
+		}
+		if (message.params.name === "release" && held !== undefined) {
+			reply(held, { content: [{ type: "text", text: "released" }] });
+			held = undefined;
+		}
+		reply(message.id, { content: [{ type: "text", text: "ok" }] });
+	}
+});
+input.on("close", () => {
+	record("stop");
+	process.exit(0);
+});
