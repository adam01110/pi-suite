+import { afterEach, describe, expect, it, vi as jest } from "vitest";
+import { mkdtempSync, readFileSync, rmSync, watch, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import type { ExtensionAPI, ExtensionToolContext, ToolDefinition } from "../src/core/extensions/types.ts";
+import { InMemoryAuthStorageBackend } from "../src/core/auth-storage.ts";
+import { validateMcpServerConfig } from "../src/core/mcp-servers.ts";
+import { createMcpExtension } from "../src/extensions/mcp/index.ts";
+import { createDefaultTransport, McpOAuthCredentialStore, McpServerConnection } from "../src/extensions/mcp/runtime.ts";
+
+const fixture = join(dirname(fileURLToPath(import.meta.url)), "fixtures/mcp-lazy-server.mjs");
+const dirs: string[] = [];
+const cleanup: (() => Promise<void>)[] = [];
+
+afterEach(async () => {
+	jest.useRealTimers();
+	for (const close of cleanup.splice(0)) await close();
+	for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function setup() {
+	const dir = mkdtempSync(join(tmpdir(), "pi-lazy-"));
+	dirs.push(dir);
+	const log = join(dir, "events");
+	writeFileSync(log, "");
+	const events = () => readFileSync(log, "utf8").trim().split("\n").filter(Boolean);
+	const config = {
+		command: process.execPath,
+		args: [fixture, log],
+		lifecycle: "lazy" as const,
+		idleTimeout: 1,
+		exposure: "direct" as const,
+	};
+	return { dir, log, events, entry: { name: "lazy", source: "test", config } };
+}
+
+function observed(log: string, event: string, count = 1): Promise<void> {
+	return new Promise((resolve) => {
+		const check = () => {
+			if (
+				readFileSync(log, "utf8")
+					.split("\n")
+					.filter((line) => line === event).length < count
+			)
+				return;
+			watcher.close();
+			resolve();
+		};
+		const watcher = watch(log, check);
+		check();
+	});
+}
+
+function runtime(stall?: string) {
+	const data = setup();
+	if (stall) data.entry.config.args.push(stall);
+	let onStalled: () => void;
+	const stalled = new Promise<void>((resolve) => {
+		onStalled = resolve;
+	});
+	let idle: (() => void) | undefined;
+	const connection = new McpServerConnection({
+		entry: data.entry,
+		cwd: data.dir,
+		createTransport: (entry, cwd, auth) => {
+			const transport = createDefaultTransport(entry, cwd, auth);
+			transport.onMessage((message) => {
+				if ("method" in message && message.method === "notifications/lazy/stalled") onStalled();
+			});
+			return transport;
+		},
+		credentials: new McpOAuthCredentialStore(new InMemoryAuthStorageBackend()),
+		onTools: () => {},
+		onChange: (current) => {
+			if (current.state === "idle") idle?.();
+		},
+	});
+	cleanup.push(() => connection.close());
+	return {
+		...data,
+		connection,
+		stalled,
+		idle: () =>
+			new Promise<void>((resolve) => {
+				idle = resolve;
+			}),
+	};
+}
+
+async function extension(configOverride = {}) {
+	const data = setup();
+	Object.assign(data.entry.config, configOverride);
+	const tools = new Map<string, ToolDefinition>();
+	const handlers = new Map<string, (...args: any[]) => any>();
+	const commands = new Map<string, any>();
+	let active: string[] = [];
+	const pi = {
+		on: (name: string, handler: (...args: any[]) => any) => handlers.set(name, handler),
+		registerCommand: (name: string, definition: unknown) => commands.set(name, definition),
+		registerTool: (definition: ToolDefinition) => {
+			tools.set(definition.name, definition);
+			if (definition.exposure === "direct") active.push(definition.name);
+		},
+		getMcpServers: () => [],
+		getAllTools: () => [...tools.values()],
+		getActiveTools: () => active,
+		setActiveTools: (names: string[]) => {
+			active = names;
+		},
+	} as unknown as ExtensionAPI;
+	const ctx = {
+		cwd: data.dir,
+		mode: "json",
+		modelRegistry: {},
+		ui: { notify: () => {} },
+	} as unknown as ExtensionToolContext;
+	createMcpExtension({
+		loadConfig: () => ({ servers: [data.entry], errors: [] }),
+		credentials: new McpOAuthCredentialStore(new InMemoryAuthStorageBackend()),
+		logPath: join(data.dir, "mcp.log"),
+	})(pi);
+	await handlers.get("session_start")?.({}, ctx);
+	cleanup.push(async () => {
+		await handlers.get("session_shutdown")?.({}, ctx);
+	});
+	await commands.get("mcp").handler("", ctx);
+	const call = (name: string, args = {}) => tools.get(name)!.execute("test", args, undefined, undefined, ctx);
+	return { ...data, tools, handlers, commands, ctx, call };
+}
+
+describe("native lazy MCP lifecycle (real stdio)", () => {
+	it("validates lifecycle and finite seconds without changing defaults", () => {
+		expect(validateMcpServerConfig("x", { command: "x" })).toEqual({ command: "x" });
+		for (const value of [-1, Infinity, NaN, "60", 2147484])
+			expect(typeof validateMcpServerConfig("x", { command: "x", idleTimeout: value })).toBe("string");
+		expect(typeof validateMcpServerConfig("x", { command: "x", lifecycle: "other" })).toBe("string");
+		expect(validateMcpServerConfig("x", { command: "x", lifecycle: "lazy", idleTimeout: 60 })).toEqual({
+			command: "x",
+			lifecycle: "lazy",
+			idleTimeout: 60,
+		});
+	});
+
+	it("starts no process until mcp_connect, then exposes and reuses native tools", async () => {
+		const h = await extension();
+		expect(h.events()).toEqual([]);
+		expect(h.tools.has("mcp__lazy__echo")).toBe(false);
+		expect(h.tools.get("mcp_connect")?.description).toContain("lazy");
